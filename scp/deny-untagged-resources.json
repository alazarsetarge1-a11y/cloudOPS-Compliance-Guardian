{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCreateWithoutOwnerTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "s3:CreateBucket",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:s3:::*",
        "arn:aws:rds:*:*:db:*",
        "arn:aws:rds:*:*:cluster:*",
        "arn:aws:iam::*:role/*"
      ],
      "Condition": {
        "Null": { "aws:RequestTag/owner": "true" },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/OrganizationBreakGlass"
        }
      }
    },
    {
      "Sid": "DenyCreateWithoutEnvironmentTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "s3:CreateBucket",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:s3:::*",
        "arn:aws:rds:*:*:db:*",
        "arn:aws:rds:*:*:cluster:*",
        "arn:aws:iam::*:role/*"
      ],
      "Condition": {
        "Null": { "aws:RequestTag/environment": "true" },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/OrganizationBreakGlass"
        }
      }
    },
    {
      "Sid": "DenyCreateWithoutCostCenterTag",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVolume",
        "s3:CreateBucket",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:s3:::*",
        "arn:aws:rds:*:*:db:*",
        "arn:aws:rds:*:*:cluster:*",
