        "rds:CreateDBCluster",
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:s3:::*",
        "arn:aws:rds:*:*:db:*",
        "arn:aws:rds:*:*:cluster:*",
        "arn:aws:iam::*:role/*"
      ],
      "Condition": {
        "Null": { "aws:RequestTag/data-classification": "true" },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/OrganizationBreakGlass"
        }
      }
    }
  ]
}
