# Copy to .env.local (gitignored) and set for your environment.
# NOTE: Vite inlines VITE_* vars into the built JS — they are NOT secret.
# The API key here only gates casual access in dev; production uses real user
# auth (Cognito) in front of the API, not a static browser-embedded key.
VITE_API_BASE=http://localhost:8000
VITE_API_KEY=dev-local-key
