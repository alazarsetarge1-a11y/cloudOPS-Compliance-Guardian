# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Node
node_modules/
dist/
build/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# terraform.tfvars(.json) holds the real member account id — never commit it.
# The committed *.tfvars.example carries only a placeholder.
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it so provider
# versions/checksums are pinned and reproducible across machines and CI.

# IDE
.vscode/
.idea/
.DS_Store
